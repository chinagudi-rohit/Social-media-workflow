# Copy to .env for local runs. For scheduled cloud runs add these as environment
# variables in the cloud environment's settings instead. .env is git-ignored.
# None of these are needed when publishing and analytics go through the Metricool
# connector (browser sign-in; see README "Setup").

# Upload-Post: publishes to Instagram, YouTube and Facebook, and reads analytics.
UPLOADPOST_API_KEY=
UPLOADPOST_USER=                 # the Upload-Post profile username
UPLOADPOST_FACEBOOK_PAGE_ID=     # Facebook Page to post Reels to

# YouTube Data + Analytics API (direct upload fallback and revenue numbers).
# Refresh token scopes: youtube.upload yt-analytics.readonly yt-analytics-monetary.readonly
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Facebook Content Monetization earnings (Page insights).
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Instagram Graph API (direct Reels fallback when Upload-Post is not used).
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_GRAPH_HOST=graph.facebook.com
# IG_GRAPH_API_VERSION=v23.0
