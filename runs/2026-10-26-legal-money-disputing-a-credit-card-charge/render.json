    {
      "text": "The Fair Credit Billing Act lets you dispute credit card errors, including things you paid for but never got.",
      "image_url": null,
      "motion_url": null,
      "shots": [
        {
          "words": 11,
          "image_url": null,
          "motion_url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KiaiPFpiBgipyl9nPlZn5fUZ7G/hf_20261026_140647_0671e8bb-0833-4ead-a02f-912245634efb.mp4",
          "overlay": "FAIR CREDIT BILLING ACT",
          "counter": null,
          "sfx": null,
          "clip_start": 0.0,
          "clip_len": 4.1
        },
        {
          "words": 8,
          "image_url": null,
          "motion_url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KiaiPFpiBgipyl9nPlZn5fUZ7G/hf_20261026_140647_0671e8bb-0833-4ead-a02f-912245634efb.mp4",
          "overlay": null,
          "counter": null,
          "sfx": null,
          "clip_start": 4.1,
          "clip_len": 2.9
        }
      ]
    },
    {
