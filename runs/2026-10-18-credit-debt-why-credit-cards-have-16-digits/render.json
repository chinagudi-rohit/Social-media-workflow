  "hook_title": "Why do cards have *16* digits?",
  "hook_seconds": 2.6,
  "shot_seconds": 3.5,
  "audio": {
    "music_db": -27,
    "sfx_db": -19,
    "native_db": -25,
    "seed": 31368
